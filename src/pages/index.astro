---
// Beranda (desain E · "Studio", disetujui owner 2026-11-09): gabungan referensi Studio Opus (layout putih bersih,
// daftar layanan bernomor, section gelap, pricing, perspectives) dan Mondra (wordmark raksasa, grid karya 2×2,
// workflow 3 kartu, testimoni gambar besar, awards). Aksen biru kini berlaku untuk seluruh situs (global.css).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { img } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const selectedWorks = projects.slice(0, 4);
const pad = (n: number) => String(n).padStart(2, '0');

// What we do: four disciplines, each with the image shown while its row is open.
const disciplines = [
  { name: 'Web design', text: 'Websites and interfaces with a clear structure and a distinct look, tested with real users.', image: 'p-northwind' },
  { name: 'Creative web development', text: 'Motion, WebGL and scroll-driven storytelling, built fast and accessible.', image: 'p-halcyon' },
  { name: 'Web app', text: 'Dashboards, portals and SaaS products built to last, with tests, docs and a clean handover.', image: 'p-meridian' },
  { name: 'Brand visualization', text: 'Brand identities, 3D visuals and motion that make your product recognizable everywhere.', image: 'p-pulse' },
];
---
<BaseLayout title="Magiapix" description="Magiapix is an independent design and engineering studio in Brooklyn. Strategy, brand, websites and products for startups and growing companies.">
  <!-- 1. Hero: meta + angka, foto lebar, wordmark raksasa -->
  <section class="e-hero" data-mood="paper" aria-labelledby="e-h1">
    <div class="wrap e-hero-top">
      <div class="e-hero-meta" data-intro>
        <p class="type-small muted">Brooklyn, NY<br />Est. 2016</p>
        <div class="e-faces" aria-hidden="true">{[0, 1, 2].map((k) => <Image src={img(`t-${k + 1}`)} alt="" width={88} height={88} />)}</div>
        <p class="type-small">24 people who<br />ship every week</p>
      </div>
      <div class="e-hero-lead" data-intro>
        <h1 id="e-h1" class="e-lead">Brand image, experiences and feels that come from unforgettable apps.</h1>
        <dl class="e-mini">
          <div><dd>10</dd><dt>Years of practice</dt></div>
          <div><dd>140+</dd><dt>Products shipped</dt></div>
          <div><dd>32</dd><dt>Awards</dt></div>
        </dl>
      </div>
    </div>
    <div class="e-hero-img">
      <!-- WebM (1,4 MB) dimuat lebih dulu; MP4 (5,4 MB) hanya untuk browser yang tidak bisa memutar WebM -->
      <video
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        aria-label="Dewy blue petals in slow macro motion"
      >
        <source src="/assets/aistudio/magiapix.webm" type="video/webm" />
        <source src="/assets/aistudio/StockCake-Dewy_Blue_Flower-0f877554-1627-4960-810f-e3df7fc085b4-original_fb1358e8.mp4" type="video/mp4" />
      </video>
      <div class="e-hero-scrim" aria-hidden="true"></div>
    </div>
    <p class="e-word" aria-hidden="true"><span class="e-word-in"><span>magia</span><b>pix</b></span></p>
  </section>

  <!-- 2. Intro: kalimat besar dengan empat foto kapsul dari Selected Works di antara kata (melebar saat terlihat); kata abu-abu menjadi hitam mengikuti scroll -->
  <section class="sec e-intro io2" data-mood="paper" aria-label="About us">
    <div class="wrap">
      <p class="io2-t" data-scrub>We design {selectedWorks[0] && <span class="io-pic" aria-hidden="true">{selectedWorks[0].data.coverVideo ? <video src={selectedWorks[0].data.coverVideo} data-vplay muted loop playsinline preload="auto"></video> : <Image src={selectedWorks[0].data.cover} alt="" widths={[300, 600]} sizes="16vw" style={selectedWorks[0].id === 'floating-geometrical-layers' ? 'object-position: right center;' : undefined} loading="eager" />}</span>} and develop high-performance and aesthetic applications {selectedWorks[1] && <span class="io-pic" aria-hidden="true">{selectedWorks[1].data.coverVideo ? <video src={selectedWorks[1].data.coverVideo} data-vplay muted loop playsinline preload="auto"></video> : <Image src={selectedWorks[1].data.cover} alt="" widths={[300, 600]} sizes="16vw" style={selectedWorks[1].id === 'floating-geometrical-layers' ? 'object-position: right center;' : undefined} loading="eager" />}</span>} so your brand can stand {selectedWorks[2] && <span class="io-pic" aria-hidden="true">{selectedWorks[2].data.coverVideo ? <video src={selectedWorks[2].data.coverVideo} data-vplay muted loop playsinline preload="auto"></video> : <Image src={selectedWorks[2].data.cover} alt="" widths={[300, 600]} sizes="16vw" style={selectedWorks[2].id === 'floating-geometrical-layers' ? 'object-position: right center;' : undefined} loading="eager" />}</span>} out and gain more recognition in a highly competitive market {selectedWorks[3] && <span class="io-pic" aria-hidden="true">{selectedWorks[3].data.coverVideo ? <video src={selectedWorks[3].data.coverVideo} data-vplay muted loop playsinline preload="auto"></video> : <Image src={selectedWorks[3].data.cover} alt="" widths={[300, 600]} sizes="16vw" style={selectedWorks[3].id === 'floating-geometrical-layers' ? 'object-position: right center;' : undefined} loading="eager" />}</span>}.</p>
    </div>
  </section>

  <!-- 3. Selected works: foto proyek selebar layar, nama klien raksasa di atas foto -->
  <section class="sec e-wk" data-mood="paper" aria-labelledby="e-works">
    <div class="wrap e-head e-wk-head">
      <h2 class="e-h2 e-wk-title" id="e-works">Selected <span class="e-wk-tail">works <sup>({projects.length})</sup></span></h2>
      <a class="ulink type-small e-wk-all" href="/projects/">View all →</a>
    </div>
    <div class="e-wk-list">
      {selectedWorks.map((p, i) => (
        <a class="e-wk-item" href={`/projects/${p.id}/`} data-cursor="View">
          <div class="e-wk-img">{p.data.coverVideo ? <video src={p.data.coverVideo} data-vplay muted loop playsinline preload="auto" aria-label={p.data.coverAlt}></video> : <Image src={p.data.cover} alt={p.data.coverAlt} widths={[1280, 1920, 2400]} sizes="100vw" quality={95} style={p.id === 'floating-geometrical-layers' ? 'object-position: right center;' : undefined} loading="eager" />}</div>
          <div class="wrap e-wk-cap">
            <span class="e-wk-n type-small">{pad(i + 1)} / {pad(projects.length)}</span>
            <h3 class="e-wk-t">{p.data.client}</h3>
            <ul class="e-wk-tags"><li class="is-res">{p.data.result}</li><li>{p.data.categoryLabel}</li><li>{p.data.year}</li></ul>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Layer transisi morphing: memindahkan 4 gambar About Us turun membentuk 4 kartu Selected Works -->
  <div class="io-morph-layer" aria-hidden="true">
    {selectedWorks.map((p) => (
      <div class="io-morph-card">
        {p.data.coverVideo ? <video src={p.data.coverVideo} data-vplay muted loop playsinline preload="auto"></video> : <Image
          src={p.data.cover}
          alt=""
          widths={[1280, 1920, 2400]}
          sizes="100vw"
          quality={95}
          style={p.id === 'floating-geometrical-layers' ? 'object-position: right center;' : undefined}
          loading="eager"
        />}
      </div>
    ))}
  </div>

  <!-- 4b. What we do: label + gambar di kiri (berganti sesuai baris yang terbuka), daftar disiplin besar berupa akordeon di kanan -->
  <section class="sec e-wd" data-mood="paper" aria-labelledby="e-wd-t">
    <div class="wrap e-wd-in">
      <div class="e-wd-side">
        <h2 class="e-h2 e-wd-t" id="e-wd-t" data-reveal>What we do <sup>({disciplines.length})</sup></h2>
        <div class="e-wd-frame" data-clip aria-hidden="true">
          {disciplines.map((d) => <Image class="e-wd-img" src={img(d.image)} alt="" widths={[480, 960]} sizes="(min-width: 1024px) 30vw, 92vw" />)}
        </div>
      </div>
      <div class="e-wd-main">
        <div class="acc e-wd-list" data-stagger>
          {disciplines.map((d, i) => (
            <div class:list={['acc-item', { open: i === 0 }]}>
              <button class="acc-btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`wd-${i}`}>
                <span class="e-wd-name">{d.name}</span>
                <span class="arr" aria-hidden="true">+</span>
              </button>
              <div class="acc-panel" id={`wd-${i}`}>
                <div class="e-wd-body">
                  <p>{d.text}</p>
                  <div class="e-wd-pic" aria-hidden="true"><Image src={img(d.image)} alt="" widths={[480, 960]} sizes="92vw" /></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { glideTo, isGliding } from '../scripts/glide';
  gsap.registerPlugin(SplitText, ScrollTrigger);
  const root = document.documentElement;

  // Setiap video proyek tampil di 3 tempat (kapsul About us, layer morph, kartu Selected works).
  // Daripada 3 salinan yang di-decode bersamaan dan harus di-seek saat bergantian (frame lama tampil
  // sesaat lalu meloncat), hanya 1 elemen video per proyek yang dipakai: elemen itu dipindah ke tempat
  // yang sedang terlihat. Video yang dipindah dalam satu task tetap berputar tanpa jeda dan tanpa seek.
  // Video dijeda bila tempatnya di luar layar.
  interface VGroup { video: HTMLVideoElement; pill: HTMLElement | null; clone: HTMLElement | null; box: HTMLElement; item: HTMLElement }
  const vInView = new WeakMap<Element, boolean>();
  const morphLayerEl = document.querySelector<HTMLElement>('.io-morph-layer');
  const pillEls = [...document.querySelectorAll<HTMLElement>('.io-pic')];
  const cloneEls = [...document.querySelectorAll<HTMLElement>('.io-morph-card')];
  const vGroups: VGroup[] = [];
  [...document.querySelectorAll<HTMLElement>('.e-wk-item')].forEach((item, i) => {
    const box = item.querySelector<HTMLElement>('.e-wk-img');
    const video = box?.querySelector<HTMLVideoElement>('video[data-vplay]');
    if (!box || !video) return;
    const pill = pillEls[i] ?? null;
    const clone = cloneEls[i] ?? null;
    if (!root.classList.contains('no-motion')) {
      pill?.querySelector('video[data-vplay]')?.remove();
      clone?.querySelector('video[data-vplay]')?.remove();
    }
    vGroups.push({ video, pill, clone, box, item });
  });
  // Mobile: video sedikit membesar (1.15) selama di kapsul/layer morph, lalu zoom out pelan ke 1 dalam
  // 1,2 detik begitu menjadi kartu Selected works. Memakai properti CSS `scale` (terpisah dari transform
  // parallax GSAP) dan WAAPI, karena transisi CSS tidak jalan pada elemen yang baru dipindah induknya.
  const mobileMq = matchMedia('(max-width: 767px)');
  const zoomVideo = (v: HTMLVideoElement, inCard: boolean) => {
    const target = mobileMq.matches && !inCard ? '1.15' : '1';
    const from = v.style.scale || '1';
    if (from === target) return;
    v.style.scale = target;
    v.animate([{ scale: from }, { scale: target }], { duration: 1200, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
  };
  const syncVideos = () => {
    if (root.classList.contains('no-motion')) return;
    const layerOn = !morphLayerEl || morphLayerEl.style.visibility !== 'hidden';
    for (const g of vGroups) {
      let host: HTMLElement | null = null;
      if (g.clone && layerOn && g.clone.style.visibility === 'visible') host = g.clone;
      else if (g.box.style.opacity !== '0' && vInView.get(g.item)) host = g.box;
      else if (g.pill && g.pill.style.visibility !== 'hidden' && vInView.get(g.pill)) host = g.pill;
      if (host) {
        if (g.video.parentElement !== host) host.prepend(g.video);
        zoomVideo(g.video, host === g.box);
        if (g.video.paused) g.video.play().catch(() => {});
      } else if (!g.video.paused) g.video.pause();
    }
  };
  const vObserver = new IntersectionObserver((entries) => {
    entries.forEach((en) => vInView.set(en.target, en.isIntersecting));
    syncVideos();
  }, { rootMargin: '10% 0px' });
  vGroups.forEach((g) => { vObserver.observe(g.item); if (g.pill) vObserver.observe(g.pill); });
  // Hero: saat di-scroll, image melebar penuh 100svh, elemen atas mengecil 60% di sisi atas image,
  // burger menu turun ke sisi kanan heading, dan logo kiri atas turun ke bawah menggantikan wordmark magiapix.
  const run = () => {
    const hero = document.querySelector<HTMLElement>('.e-hero');
    const heroVideo = hero?.querySelector<HTMLVideoElement>('.e-hero-img video') ?? null;
    if (root.classList.contains('no-motion')) {
      heroVideo?.pause();
      return;
    }
    const heroTop = document.querySelector<HTMLElement>('.e-hero-top');
    const heroMeta = document.querySelector<HTMLElement>('.e-hero-meta');
    const heroLead = document.querySelector<HTMLElement>('.e-hero-lead');
    const heroImg = document.querySelector<HTMLElement>('.e-hero-img');
    const heroImgEl = heroImg?.querySelector<HTMLElement>('img, video') ?? null;
    const heroScrim = heroImg?.querySelector<HTMLElement>('.e-hero-scrim') ?? null;
    const word = document.querySelector<HTMLElement>('.e-word');
    const wordIn = word?.querySelector<HTMLElement>('.e-word-in') ?? null;
    const header = document.querySelector<HTMLElement>('.site-header');
    const headerLogo = header?.querySelector<HTMLElement>('.logo') ?? null;
    const menuBtn = header?.querySelector<HTMLElement>('.menu-btn') ?? null;
    const menuIcon = menuBtn?.querySelector<HTMLElement>('i') ?? null;
    if (!hero || !heroTop || !heroImg || !word || !wordIn) return;

    const getGutter = () => parseFloat(getComputedStyle(heroTop).paddingLeft) || 16;
    const getInitImgTop = () => heroTop.offsetHeight;
    const getInitImgHeight = () => Math.min(720, Math.max(320, innerHeight * 0.58));
    const getInitRadius = () => Math.min(32, Math.max(20, innerWidth * 0.022));
    const getTargetTop = () => (innerWidth >= 768 ? 28 : 20);
    const isDesktop = () => innerWidth >= 1024;
    const isMetaHidden = () => !heroMeta || getComputedStyle(heroMeta).display === 'none';
    const isLeadFirst = () => !!heroLead && !isMetaHidden() && heroLead.offsetTop < heroMeta!.offsetTop;

    // Gap between the stacked, scaled-down headline and meta row on mobile/tablet.
    const STACK_GAP = 24;

    const getMetaTargetTop = () => {
      if (isDesktop() || !heroLead || !isLeadFirst()) return getTargetTop();
      return getTargetTop() + heroLead.offsetHeight * 0.6 + STACK_GAP;
    };

    const getLeadTargetTop = () => {
      if (isDesktop() || isMetaHidden() || isLeadFirst()) return getTargetTop();
      return getTargetTop() + heroMeta!.offsetHeight * 0.6 + STACK_GAP;
    };

    const getMenuTargetTop = () => {
      const leadTop = getLeadTargetTop();
      const iconOffset = menuIcon ? menuIcon.offsetTop : 18;
      return leadTop + 4 - iconOffset;
    };

    const getLogoWidth = () => {
      if (!headerLogo) return 120;
      const sup = headerLogo.querySelector<HTMLElement>('sup');
      return headerLogo.offsetWidth - (sup ? sup.offsetWidth : 0);
    };
    const getWordStartScale = () => (wordIn.offsetWidth ? getLogoWidth() / wordIn.offsetWidth : 0.1);
    const getWordStartX = () => {
      if (!headerLogo) return 0;
      return headerLogo.offsetLeft - (word.offsetLeft + wordIn.offsetLeft);
    };
    const getWordStartY = () => {
      if (!headerLogo) return 0;
      const scaledH = wordIn.offsetHeight * getWordStartScale();
      const targetTop = headerLogo.offsetTop + (headerLogo.offsetHeight - scaledH) / 2;
      return targetTop - (word.offsetTop + wordIn.offsetTop);
    };

    // Record resting colors once, before any tween touches them. With invalidateOnRefresh,
    // a plain .to() re-reads its start on every refresh; if that happens mid-scroll the
    // start becomes white and the text stays invisible on the white hero after scrolling back.
    const restColor = (el: Element | null) => (el ? getComputedStyle(el).color : '');
    const metaMutedEl = heroMeta?.querySelector<HTMLElement>('.muted') ?? null;
    const miniLabelEls = heroLead ? [...heroLead.querySelectorAll<HTMLElement>('.e-mini dt')] : [];
    const miniAccentEl = heroLead?.querySelector<HTMLElement>('.e-mini > div:nth-child(2) dd') ?? null;
    const wordBoldEl = wordIn.querySelector<HTMLElement>('b');
    const metaMutedColor = restColor(metaMutedEl);
    const miniLabelColor = restColor(miniLabelEls[0] ?? null);
    const miniAccentColor = restColor(miniAccentEl);
    const wordBoldColor = restColor(wordBoldEl);

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1px)', () => {
      gsap.set(heroTop, { position: 'relative', zIndex: 3 });
      gsap.set(heroImg, { position: 'absolute', zIndex: 1, marginInline: 0 });
      gsap.set(word, {
        position: 'absolute',
        left: 0,
        right: 0,
        bottom: 'clamp(12px, 2.5vh, 32px)',
        margin: 0,
        zIndex: 3,
      });

      if (heroMeta) gsap.set(heroMeta, { transformOrigin: 'top left' });
      if (heroLead) gsap.set(heroLead, { transformOrigin: isDesktop() ? 'top right' : 'top left' });

      // Satu kali scroll memicu animasi penuh (bukan scrub): halaman meluncur sendiri ke akhir pin
      // selama animasi berjalan, dan input scroll dikunci sampai selesai. Scroll ke atas dari bawah hero
      // meluncur kembali ke paling atas dan animasinya diputar balik.
      const glide = (to: number) => glideTo(to, 1.2);

      const tl = gsap.timeline({
        scrollTrigger: {
          id: 'e-hero',
          trigger: hero,
          start: 'top top-=1',
          end: () => `+=${Math.max(1200, innerHeight * 1.55)}`,
          pin: true,
          toggleActions: 'play none none reverse',
          anticipatePin: 1,
          refreshPriority: 10,
          invalidateOnRefresh: true,
          onRefresh: () => {
            if (heroLead) gsap.set(heroLead, { transformOrigin: isDesktop() ? 'top right' : 'top left' });
          },
          onEnter: (self) => glide(self.end + 1),
          onLeave: () => {
            if (header) {
              header.classList.remove('is-solid');
              if (menuBtn) gsap.set(menuBtn, { clearProps: 'color' });
              gsap.to(header, { yPercent: -110, duration: 0.25, ease: 'power2.out', overwrite: true });
            }
          },
          onEnterBack: (self) => {
            glide(0);
            self.animation?.reverse();
            if (header) {
              header.classList.remove('is-solid');
              if (headerLogo) gsap.set(headerLogo, { autoAlpha: 0 });
              if (menuBtn) gsap.set(menuBtn, { y: getMenuTargetTop() - menuBtn.offsetTop, color: '#ffffff' });
              gsap.to(header, { yPercent: 0, duration: 0.22, ease: 'power2.out', overwrite: true });
            }
          },
        },
      });

      tl.fromTo(
        heroImg,
        {
          top: getInitImgTop,
          left: getGutter,
          right: getGutter,
          height: getInitImgHeight,
          borderRadius: getInitRadius,
        },
        {
          top: 0,
          left: 0,
          right: 0,
          height: () => hero.clientHeight,
          borderRadius: 0,
          duration: 1,
          ease: 'power2.inOut',
        },
        0,
      );

      if (heroImgEl) {
        tl.fromTo(
          heroImgEl,
          { scale: 1.08 },
          { scale: 1, duration: 1, ease: 'power2.inOut' },
          0,
        );
      }

      if (heroScrim) {
        tl.fromTo(
          heroScrim,
          { opacity: 0 },
          { opacity: 1, duration: 0.5, ease: 'none' },
          0.2,
        );
      }

      if (heroMeta) {
        tl.fromTo(
          heroMeta,
          { scale: 1, y: 0, color: '#0e1116' },
          {
            scale: 0.6,
            y: () => (isMetaHidden() ? 0 : getMetaTargetTop() - heroMeta.offsetTop),
            color: '#ffffff',
            duration: 1,
            ease: 'power2.inOut',
          },
          0,
        );
        if (metaMutedEl) {
          tl.fromTo(metaMutedEl, { color: metaMutedColor }, { color: 'rgba(255, 255, 255, 0.78)', duration: 0.5, ease: 'none' }, 0.2);
        }
      }

      if (heroLead) {
        tl.fromTo(
          heroLead,
          { scale: 1, x: 0, y: 0, color: '#0e1116' },
          {
            scale: 0.6,
            x: () => (isDesktop() && menuBtn ? -(menuBtn.offsetWidth + 24) : 0),
            y: () => getLeadTargetTop() - heroLead.offsetTop,
            color: '#ffffff',
            duration: 1,
            ease: 'power2.inOut',
          },
          0,
        );
        if (miniLabelEls.length) {
          tl.fromTo(miniLabelEls, { color: miniLabelColor }, { color: 'rgba(255, 255, 255, 0.78)', duration: 0.5, ease: 'none' }, 0.2);
        }
        if (miniAccentEl) {
          tl.fromTo(miniAccentEl, { color: miniAccentColor }, { color: '#78b4ff', duration: 0.5, ease: 'none' }, 0.2);
        }
      }

      if (menuBtn) {
        tl.fromTo(
          menuBtn,
          { y: 0, color: '#0e1116' },
          {
            y: () => getMenuTargetTop() - menuBtn.offsetTop,
            color: '#ffffff',
            duration: 1,
            ease: 'power2.inOut',
          },
          0,
        );
      }

      if (headerLogo) {
        tl.fromTo(
          headerLogo,
          { autoAlpha: 1 },
          { autoAlpha: 0, duration: 0.06, ease: 'none' },
          0,
        );
      }

      tl.fromTo(
        wordIn,
        {
          x: getWordStartX,
          y: getWordStartY,
          scale: getWordStartScale,
          color: '#0e1116',
        },
        {
          x: 0,
          y: 0,
          scale: 1,
          color: '#ffffff',
          duration: 1,
          ease: 'power2.inOut',
        },
        0,
      );

      if (wordBoldEl) {
        tl.fromTo(wordBoldEl, { color: wordBoldColor }, { color: '#78b4ff', duration: 0.5, ease: 'none' }, 0.2);
      }

      if (headerLogo) {
        tl.fromTo(
          wordIn,
          { opacity: 0 },
          { opacity: 1, duration: 0.06, ease: 'none' },
          0,
        );
      }

      tl.to({}, { duration: 0.25 });
    });
  };

  // Selected works: foto bergerak pelan (parallax) dan judul naik saat kartu masuk layar.
  const outro = () => {
    if (root.classList.contains('no-motion')) return;
    const ct = document.querySelector<HTMLElement>('.e-cta-t');
    if (ct) { const sp = new SplitText(ct, { type: 'words', aria: 'none' }); gsap.from(sp.words, { yPercent: 60, opacity: 0, duration: 0.9, ease: 'power4.out', stagger: 0.04, scrollTrigger: { trigger: ct, start: 'top 80%' } }); }
  };
  const works = () => {
    if (root.classList.contains('no-motion')) return;
    document.querySelectorAll<HTMLElement>('.e-wk-item').forEach((it, idx) => {
      gsap.fromTo(it.querySelector('.e-wk-img img') ?? vGroups[idx]?.video ?? null, { yPercent: 0 }, { yPercent: -8, ease: 'none', scrollTrigger: { trigger: it, start: 'top top', end: 'bottom top', scrub: true } });
      if (idx >= 4) {
        gsap.from(it.querySelectorAll('.e-wk-n, .e-wk-t, .e-wk-tags li'), {
          y: 24,
          opacity: 0,
          duration: 0.7,
          ease: 'power3.out',
          stagger: 0.05,
          scrollTrigger: { trigger: it, start: 'top 25%' },
        });
      }
    });
  };
  // Review kapsul: bila lebih dari satu, berganti tiap 4,5 detik (naik keluar, masuk dari bawah) selama terlihat; berhenti saat hover.
  document.querySelectorAll<HTMLElement>('[data-rv]').forEach((box) => {
    const its = [...box.querySelectorAll<HTMLElement>('.dv-rv-i')];
    if (its.length < 2 || root.classList.contains('no-motion')) return;
    let cur = 0, seen = false, hold = false;
    box.addEventListener('pointerenter', () => { hold = true; });
    box.addEventListener('pointerleave', () => { hold = false; });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; }).observe(box);
    setInterval(() => {
      if (!seen || hold || document.hidden) return;
      const prev = its[cur]; cur = (cur + 1) % its.length; const next = its[cur];
      its.forEach((x) => x.classList.remove('is-out'));
      prev.classList.remove('is-on'); prev.classList.add('is-out'); prev.setAttribute('aria-hidden', 'true');
      next.classList.add('is-on'); next.removeAttribute('aria-hidden');
    }, 4500);
  });
  // Intro: section dipin selama animasi opacity + blur kalimat & kapsul berlangsung, lalu lanjut scroll setelah selesai.
  const intro = () => {
    if (root.classList.contains('no-motion')) return;
    const introSec = document.querySelector<HTMLElement>('.e-intro');
    const sc = document.querySelector<HTMLElement>('[data-scrub]');
    if (!introSec || !sc) return;

    const sp = new SplitText(sc, { type: 'words', tag: 'span', aria: 'none' });
    const tokens = Array.from(sc.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );
    const targets = tokens.length ? tokens : sp.words;
    const exitWrappers = targets
      .filter((el): el is HTMLElement => el instanceof HTMLElement && !el.classList.contains('io-pic'))
      .map((w) => {
        const ex = document.createElement('span');
        ex.className = 'io-ex';
        w.parentNode?.insertBefore(ex, w);
        ex.appendChild(w);
        return ex;
      });

    const EXPAND_SHARE = 0.6;
    const tl = gsap.timeline({
      scrollTrigger: {
        id: 'e-intro',
        trigger: introSec,
        start: 'top top',
        // Pin diperpanjang 60%: bagian akhir dipakai gambar pertama untuk melebar penuh layar.
        end: () => `+=${Math.max(1200, innerHeight * 1.8) * (1 + EXPAND_SHARE)}`,
        pin: true,
        scrub: 0.35,
        anticipatePin: 1,
        refreshPriority: 5,
        invalidateOnRefresh: true,
        onLeave: (self) => self.getTween()?.progress(1),
        onLeaveBack: (self) => self.getTween()?.progress(0),
      },
    });

    tl.fromTo(
      targets,
      { opacity: 0.12, filter: 'blur(7px)' },
      {
        opacity: 1,
        filter: 'blur(0px)',
        duration: 2.2,
        ease: 'power1.out',
        stagger: 0.35,
      },
      0,
    );

    // Beri jeda singkat setelah seluruh kalimat tajam sebelum melepas pin ke section berikutnya
    tl.to({}, { duration: 0.6 });
    // Sisa pin (fase melebar) tidak menggerakkan kalimat; ditangani updateMorph.
    tl.to({}, { duration: tl.duration() * EXPAND_SHARE });

    // Setelah About Us selesai di-scroll, ke-4 gambar kapsul berpindah turun dan membentuk 4 kartu di Selected Works
    const pics = Array.from(sc.querySelectorAll<HTMLElement>('.io-pic'));
    const morphLayer = document.querySelector<HTMLElement>('.io-morph-layer');
    const clones = Array.from(document.querySelectorAll<HTMLElement>('.io-morph-card'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.e-wk-item'));
    const cardImgBoxes = cards.map((c) => c.querySelector<HTMLElement>('.e-wk-img'));
    const cardCaps = cards.map((c) => c.querySelector<HTMLElement>('.e-wk-cap'));
    const wkTitle = document.querySelector<HTMLElement>('.e-wk-title');
    const wkAll = document.querySelector<HTMLElement>('.e-wk-all');

    if (pics.length && morphLayer && clones.length === pics.length && cards.length >= pics.length) {
      interface BoxRect {
        left: number;
        top: number;
        width: number;
        height: number;
        radius: number;
      }

      const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
      const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

      let introEndScroll = 0;
      let expandStart = 0;
      let picBase: BoxRect[] = [];
      let cardMetrics: { docTop: number; left: number; width: number; height: number }[] = [];
      let endScrolls: number[] = [];

      const getDockRect = (idx: number): BoxRect => {
        const w = innerWidth;
        const h = innerHeight;
        const gutter = parseFloat(getComputedStyle(introSec).paddingLeft) || (w >= 768 ? 40 : 16);
        const isSmall = w < 640;
        const cw = isSmall ? 60 : w < 1024 ? 76 : 92;
        const m = cardMetrics[idx];
        const cardAspect = m && m.height > 0 ? m.width / m.height : 1.75;
        const ch = Math.min(Math.round(cw * 0.72), Math.max(36, Math.round(cw / cardAspect)));
        const gap = isSmall ? 8 : 12;
        const slot = idx - 1; // 0..2 untuk kartu 1..3
        const total = 3;
        const rightMargin = isSmall ? gutter : Math.max(gutter, 92);
        const left = w - rightMargin - (total - slot) * cw - (total - 1 - slot) * gap;
        const bottomOffset = isSmall ? Math.max(116, Math.round(h * 0.16)) : Math.min(48, Math.max(24, Math.round(w * 0.03)));
        return {
          left,
          top: h - bottomOffset - ch,
          width: cw,
          height: ch,
          radius: isSmall ? 10 : 14,
        };
      };

      const measure = () => {
        const introTrig = ScrollTrigger.getById('e-intro');
        introEndScroll = introTrig ? introTrig.end : introSec.getBoundingClientRect().bottom + scrollY - innerHeight;
        const introStart = introTrig ? introTrig.start : introEndScroll;
        expandStart = introStart + (introEndScroll - introStart) / (1 + EXPAND_SHARE);

        const ir = introSec.getBoundingClientRect();
        picBase = pics.map((p) => {
          const r = p.getBoundingClientRect();
          return {
            left: r.left - ir.left,
            top: r.top - ir.top,
            width: r.width,
            height: r.height,
            radius: r.height / 2,
          };
        });

        cardMetrics = cards.slice(0, pics.length).map((c) => {
          const r = c.getBoundingClientRect();
          return {
            docTop: r.top + scrollY,
            left: r.left,
            width: r.width,
            height: r.height,
          };
        });

        endScrolls = cardMetrics.map((m) => Math.max(introEndScroll + 200, Math.round(m.docTop - innerHeight * 0.04)));
        // Kartu pertama tepat di bawah About Us: gambar penuh layar ditukar saat kartu sampai di atas layar.
        endScrolls[0] = Math.max(introEndScroll + 1, Math.round(cardMetrics[0].docTop));
      };

      const applyRect = (el: HTMLElement, box: BoxRect, opacity: number, shadowAlpha: number, scrimAlpha: number) => {
        el.style.visibility = opacity <= 0.005 ? 'hidden' : 'visible';
        el.style.opacity = opacity.toFixed(3);
        el.style.transform = `translate3d(${box.left.toFixed(1)}px, ${box.top.toFixed(1)}px, 0)`;
        el.style.width = `${box.width.toFixed(1)}px`;
        el.style.height = `${box.height.toFixed(1)}px`;
        el.style.borderRadius = `${box.radius.toFixed(1)}px`;
        el.style.setProperty('--scrim', scrimAlpha.toFixed(3));
        el.style.boxShadow = shadowAlpha > 0.01 ? `0 16px 36px oklch(0 0 0 / ${(0.24 * shadowAlpha).toFixed(3)})` : 'none';
      };

      const setCapProgress = (cap: HTMLElement | null | undefined, p: number) => {
        if (!cap) return;
        const t = easeOutCubic(clamp01(p));
        cap.style.opacity = t.toFixed(3);
        cap.style.transform = t >= 0.999 ? 'translate3d(0, 0, 0)' : `translate3d(0, ${((1 - t) * 24).toFixed(1)}px, 0)`;
      };

      const setWorksHeadProgress = (pHead: number) => {
        const t = easeOutCubic(clamp01(pHead));
        const dist = 68;
        if (wkTitle) {
          wkTitle.style.opacity = t.toFixed(3);
          wkTitle.style.transform = t >= 0.999 ? 'translate3d(0, 0, 0)' : `translate3d(${((-1 + t) * dist).toFixed(1)}px, 0, 0)`;
        }
        if (wkAll) {
          wkAll.style.opacity = t.toFixed(3);
          wkAll.style.transform = t >= 0.999 ? 'translate3d(0, 0, 0)' : `translate3d(${((1 - t) * dist).toFixed(1)}px, 0, 0)`;
        }
      };

      let wasPastIntro = false;

      const setAboutExitProgress = (pExit: number) => {
        const n = exitWrappers.length;
        if (!n) return;
        const p = clamp01(pExit);
        if (p <= 0) {
          for (let k = 0; k < n; k++) {
            exitWrappers[k].style.opacity = '1';
            exitWrappers[k].style.filter = 'none';
          }
          return;
        }
        if (p >= 1) {
          for (let k = 0; k < n; k++) {
            exitWrappers[k].style.opacity = '0';
            exitWrappers[k].style.filter = 'blur(7px)';
          }
          return;
        }
        const wordWin = 0.45;
        const spread = 1 - wordWin;
        for (let k = 0; k < n; k++) {
          const startAt = n > 1 ? (k / (n - 1)) * spread : 0;
          const wp = clamp01((p - startAt) / wordWin);
          const w = exitWrappers[k];
          if (wp <= 0) {
            w.style.opacity = '1';
            w.style.filter = 'none';
          } else if (wp >= 1) {
            w.style.opacity = '0';
            w.style.filter = 'blur(7px)';
          } else {
            const easeWp = wp * wp * (3 - 2 * wp);
            w.style.opacity = (1 - easeWp).toFixed(3);
            w.style.filter = `blur(${(easeWp * 7).toFixed(2)}px)`;
          }
        }
      };

      const updateMorph = (sy: number) => {
        if (!picBase.length || !endScrolls.length) return;
        const lastEnd = endScrolls[endScrolls.length - 1];

        if (sy <= expandStart) {
          if (wasPastIntro) {
            wasPastIntro = false;
            setAboutExitProgress(0);
          }
          setWorksHeadProgress(0);
          morphLayer.style.visibility = 'hidden';
          pics.forEach((p) => { p.style.visibility = 'visible'; });
          clones.forEach((c) => { c.style.visibility = 'hidden'; });
          cardImgBoxes.forEach((box) => { if (box) box.style.opacity = '0'; });
          cardCaps.slice(0, pics.length).forEach((cap) => setCapProgress(cap, 0));
          return;
        }

        wasPastIntro = true;

        if (sy >= lastEnd) {
          setAboutExitProgress(1);
          setWorksHeadProgress(1);
          morphLayer.style.visibility = 'hidden';
          pics.forEach((p) => { p.style.visibility = 'hidden'; });
          clones.forEach((c) => { c.style.visibility = 'hidden'; });
          cardImgBoxes.forEach((box) => { if (box) box.style.opacity = '1'; });
          cardCaps.slice(0, pics.length).forEach((cap) => setCapProgress(cap, 1));
          return;
        }

        morphLayer.style.visibility = 'visible';
        pics.forEach((p) => { p.style.visibility = 'hidden'; });

        // pe: gambar pertama melebar selama sisa pin About Us. ph: layar penuh menunggu kartu pertama naik.
        const pe = clamp01((sy - expandStart) / Math.max(1, introEndScroll - expandStart));
        const ph = clamp01((sy - introEndScroll) / Math.max(1, endScrolls[0] - introEndScroll));
        setAboutExitProgress(pe / 0.6);
        setWorksHeadProgress((ph - 0.3) / 0.6);

        for (let i = 0; i < clones.length; i++) {
          const clone = clones[i];
          const cardBox = cardImgBoxes[i];
          const cardCap = cardCaps[i];
          const targetMetric = cardMetrics[i];
          const targetBox: BoxRect = {
            left: targetMetric.left,
            top: targetMetric.docTop - sy,
            width: targetMetric.width,
            height: targetMetric.height,
            radius: 0,
          };

          if (i === 0) {
            if (sy >= endScrolls[0]) {
              clone.style.visibility = 'hidden';
              if (cardBox) cardBox.style.opacity = '1';
              setCapProgress(cardCap, 1);
            } else {
              const e = easeInOutCubic(pe);
              // Target: layar penuh (100vh) di atas layar, sama dengan ukuran kartu pertama.
              const full: BoxRect = { left: targetBox.left, top: 0, width: targetBox.width, height: targetBox.height, radius: 0 };
              const box: BoxRect = {
                left: lerp(picBase[0].left, full.left, e),
                top: lerp(picBase[0].top, full.top, e),
                width: lerp(picBase[0].width, full.width, e),
                height: lerp(picBase[0].height, full.height, e),
                radius: lerp(picBase[0].radius, 0, e),
              };
              if (cardBox) cardBox.style.opacity = '0';
              setCapProgress(cardCap, (ph - 0.72) / 0.28);
              applyRect(clone, box, 1, (1 - pe) * 0.8, e);
            }
            continue;
          }

          if (sy >= endScrolls[i]) {
            clone.style.visibility = 'hidden';
            if (cardBox) cardBox.style.opacity = '1';
            setCapProgress(cardCap, 1);
            continue;
          }

          const dock = getDockRect(i);

          if (sy <= endScrolls[0]) {
            if (cardBox) cardBox.style.opacity = '0';
            setCapProgress(cardCap, 0);
            // Fase 1: turun serentak (sedikit bertahap) dari About Us ke posisi dock kartu di Selected Works
            const delay = i * 0.06;
            const localP = clamp01((pe - delay) / Math.max(0.01, 1 - delay));
            const e = easeInOutCubic(localP);
            const box: BoxRect = {
              left: lerp(picBase[i].left, dock.left, e),
              top: lerp(picBase[i].top, dock.top, e),
              width: lerp(picBase[i].width, dock.width, e),
              height: lerp(picBase[i].height, dock.height, e),
              radius: lerp(picBase[i].radius, dock.radius, e),
            };
            applyRect(clone, box, 1, e, 0);
          } else if (sy <= endScrolls[i - 1]) {
            if (cardBox) cardBox.style.opacity = '0';
            setCapProgress(cardCap, 0);
            // Menunggu rapi sebagai mini-card di dock sampai giliran kartunya muncul
            applyRect(clone, dock, 1, 1, 0);
          } else {
            // Fase 2: mengembang dari mini-card menjadi kartu Selected Works ukuran penuh
            const pi = clamp01((sy - endScrolls[i - 1]) / Math.max(1, endScrolls[i] - endScrolls[i - 1]));
            const e = easeInOutCubic(pi);
            const box: BoxRect = {
              left: lerp(dock.left, targetBox.left, e),
              top: lerp(dock.top, targetBox.top, e),
              width: lerp(dock.width, targetBox.width, e),
              height: lerp(dock.height, targetBox.height, e),
              radius: lerp(dock.radius, 0, e),
            };
            if (cardBox) cardBox.style.opacity = pi >= 0.985 ? '1' : '0';
            setCapProgress(cardCap, (pi - 0.72) / 0.28);
            applyRect(clone, box, 1, (1 - pi), e);
          }
        }
      };

      ScrollTrigger.create({
        id: 'e-intro-morph',
        start: 0,
        end: 'max',
        refreshPriority: -1,
        onUpdate: (self) => { updateMorph(self.scroll()); syncVideos(); },
      });
      // Ukur SETELAH refresh selesai. Selama refresh GSAP melepas sementara semua pin, jadi posisi kartu yang
      // diukur di onRefresh tidak menyertakan jarak pin (kartu 1 terbaca ~3500px terlalu atas) dan luncuran
      // About us/kartu meluncur ke tempat yang salah (sampai ke footer).
      ScrollTrigger.addEventListener('refresh', () => {
        measure();
        updateMorph(window.scrollY);
        syncVideos();
      });

      // Luncuran sekali-scroll, dicek tiap scroll memakai posisi hasil measure() (bukan start/end ScrollTrigger
      // yang dihitung saat pin dilepas). Toleransi 3px menahan posisi pecahan piksel setelah luncuran
      // (layar DPR tinggi) agar tidak memicu luncuran berantai.
      // - About us ke Selected works: begitu kalimat selesai dan pengguna scroll lagi, halaman meluncur 2,6 detik
      //   sampai kartu pertama tepat di atas layar (gambar pertama melebar penuh selama luncuran); scroll ke atas
      //   dari kartu pertama meluncur balik ke kalimat.
      // - Kartu Selected works: satu kali scroll pindah ke kartu berikutnya/sebelumnya (1,6 detik); selama
      //   luncuran, mini-card di dock melebar menjadi kartu berikutnya.
      const stepCount = Math.min(cards.length, pics.length);
      const cardTop = (k: number) => Math.round(cardMetrics[k]?.docTop ?? 0);
      let lastGlideY = window.scrollY;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        const dir = Math.sign(y - lastGlideY);
        lastGlideY = y;
        if (!dir || isGliding() || !endScrolls.length) return;
        const introA = Math.round(expandStart), introB = Math.round(endScrolls[0]);
        if (introB > introA && y > introA + 3 && y < introB - 3) {
          glideTo(dir > 0 ? introB : introA - 1, 2.6, easeInOutCubic);
          return;
        }
        for (let k = 0; k < stepCount - 1; k++) {
          const a = cardTop(k), b = cardTop(k + 1);
          if (y > a + 3 && y < b - 3) {
            glideTo(dir > 0 ? b : a, 1.6, easeInOutCubic);
            return;
          }
        }
      }, { passive: true });
    }
  };
  (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => requestAnimationFrame(() => { run(); intro(); works(); outro(); ScrollTrigger.refresh(); }));
</script>

<style>
  /* Lebar konten semua section = hero & footer (tepi layar dikurangi gutter, tanpa batas 1600px) */
  :global(main .wrap), :global(.site-header .wrap) { max-width: none; }
  :global(html body .wa) { background: #fff; color: oklch(.45 .2 262); }
  :global(html body .wa::after) { border-color: #fff; }
  /* Section gelap di halaman ini benar-benar hitam seperti referensi */

  .e-h2 { font-size: var(--text-4xl); line-height: 1.04; letter-spacing: -0.04em; font-weight: 500; text-wrap: normal; }
  .e-h2 sup { position: relative; top: 0.06em; font-size: .32em; vertical-align: top; line-height: 1; letter-spacing: 0; color: var(--color-muted); }
  .e-wk-title, .e-wk-all { will-change: transform, opacity; }
  .e-wk-tail { white-space: nowrap; }
  .e-wk .e-wk-title { font-size: var(--text-xl); }
  /* Judul Selected works menimpa kartu pertama, supaya gambar penuh layar dari About Us langsung menjadi kartu itu. */
  .e-wk .e-wk-head { position: absolute; top: 0; left: 0; right: 0; z-index: 16; margin: 0; padding-top: clamp(1.5rem, 4vw, 3.5rem); color: #fff; pointer-events: none; }
  .e-wk-head a { pointer-events: auto; color: #fff; }
  .e-wk-head sup { color: oklch(1 0 0 / .7); }
  .e-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 56px); }
  .e-white { color: #fff; }
  .e-mini { display: flex; gap: clamp(20px, 3vw, 48px); margin: 0; }
  .e-mini dd { margin: 0; font-size: var(--text-3xl); line-height: 1; letter-spacing: -0.04em; font-weight: 500; font-variant-numeric: tabular-nums; }
  .e-mini dt { font-size: var(--text-xs); color: var(--color-muted); margin-top: 8px; max-width: 12ch; }
  .e-mini > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .e-mini > div:nth-child(2) dd { color: var(--color-accent); }

  /* 1. Hero */
  .e-hero { position: relative; overflow: clip; }
  :global(html.js-anim) .e-hero { height: 100svh; overflow: hidden; }
  .e-hero-top { position: relative; z-index: 3; display: grid; gap: 32px; padding-top: 120px; padding-bottom: clamp(24px, 3vw, 40px); }
  .e-hero-meta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; will-change: transform; }
  .e-faces { display: flex; }
  .e-faces img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid var(--color-bg); margin-left: -10px; }
  .e-faces img:first-child { margin-left: 0; }
  .e-hero-lead { display: grid; gap: 28px; will-change: transform; }
  .e-lead { font-size: var(--text-2xl); line-height: 1.12; letter-spacing: -0.03em; font-weight: 500; max-width: 22ch; }
  @media (max-width: 1023px) {
    .e-hero-top { padding-top: 104px; gap: 24px; }
    .e-hero-lead { order: 1; }
    .e-hero-meta { order: 2; }
  }
  @media (max-width: 767px) {
    .e-hero-top { padding-top: 96px; padding-bottom: 20px; gap: 18px; }
    .e-hero-meta { gap: 12px; }
    .e-faces img { width: 34px; height: 34px; }
    .e-mini { display: none; }
  }
  @media (min-width: 1024px) {
    .e-hero-top { grid-template-columns: 1fr 1fr; align-items: end; }
    .e-hero-lead { justify-items: start; justify-self: end; width: fit-content; } /* teks + angka menempel ke sisi kanan */
  }
  .e-hero-img { position: relative; margin-inline: var(--gutter); height: clamp(320px, 58svh, 720px); border-radius: var(--radius); overflow: hidden; background: #0f3673; }
  .e-hero-img img, .e-hero-img video { width: 100%; height: 115%; object-fit: cover; display: block; }
  :global(html.js-anim) .e-hero-img img, :global(html.js-anim) .e-hero-img video { height: 100%; }
  .e-hero-scrim { position: absolute; inset: 0; pointer-events: none; opacity: 0; background: linear-gradient(to bottom, oklch(0.14 0.04 255 / 0.56) 0%, oklch(0.14 0.04 255 / 0.14) 36%, oklch(0.14 0.04 255 / 0.12) 64%, oklch(0.14 0.04 255 / 0.64) 100%); }
  .e-word { margin: clamp(8px, 1vw, 16px) 0 0; padding-inline: calc(var(--gutter) - .04em); font-size: 24vw; line-height: .82; letter-spacing: -0.065em; font-weight: 600; white-space: nowrap; padding-bottom: .26em; margin-bottom: -.18em; pointer-events: none; }
  .e-word-in { display: inline-block; transform-origin: top left; will-change: transform, opacity; }
  .e-word b { color: var(--orange); font-weight: 600; }
