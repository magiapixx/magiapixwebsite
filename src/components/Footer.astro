---
import { SITE } from '../data/site';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return pathname === '/';
  return pathname === target || pathname.startsWith(target + '/');
};
---
<footer class="site-footer" data-mood="paper">
  <div class="fgrid">
    <div class="fcell" data-reveal>
      <a class="flink type-h3" href={SITE.emailHref}>{SITE.email}</a>
      <a class="flink" href={SITE.emailHref}>Contact us <span class="fa" aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="flegal type-small muted">
    <nav class="flegal-links" aria-label="Footer">
      <p class="frow">
        {SITE.nav.map((n) => {
          const active = isActive(n.href);
          return (
            <a class:list={['flink', active ? 'is-active' : 'muted']} href={n.href} aria-current={active ? 'page' : undefined}>{n.label}</a>
          );
        })}
      </p>
    </nav>
    <a class="totop" href="#main">Back to top <span class="a" aria-hidden="true">↑</span></a>
  </div>
  <div class="wm" data-wordmark-rise aria-hidden="true"><p>{'magiapix'.split('').map((c, i) => <span class:list={{ 'wm-accent': i >= 5 }}>{c}</span>)}</p></div>
</footer>

<style>
  .wm span:not(.wm-accent) { color: color-mix(in oklch, var(--color-fg) 20%, transparent); }
  .wm .wm-accent { color: var(--color-accent); }
  .flegal-links .is-active { color: var(--color-fg); }
  @media (max-width: 1023px) {
    .flegal { justify-content: space-between; column-gap: 16px; }
    .flegal-links { margin-left: auto; }
    .flegal-links .frow { column-gap: 16px; }
    .totop {
      order: -1;
      position: static;
      transform: none;
    }
  }
</style>
