---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import fontUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
interface Props { title: string; description: string; image?: string; type?: 'website' | 'article'; loader?: boolean; noindex?: boolean }
// Loader awal tampil di halaman pertama tiap sesi (semua halaman), sampai seluruh aset halaman selesai dimuat.
const { title, description, image, type, loader = true, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <script is:inline define:vars={{ loader }}>
      (function () {
        var r = document.documentElement, pref = null;
        try { pref = localStorage.getItem('bb-motion'); } catch (e) {}
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) r.classList.add('sys-reduce');
        // Loader awal (juga untuk reduced motion): halaman tertutup sampai semua aset selesai dimuat (loader.ts).
        // Pengaman: bila skrip gagal jalan, loader dilepas setelah 90 detik supaya halaman tetap bisa dipakai.
        var loading = false;
        try { loading = loader && !sessionStorage.getItem('bb-loaded'); } catch (e) {}
        if (loading) {
          r.classList.add('is-loading');
          setTimeout(function () { r.classList.remove('is-loading'); }, 90000);
        }
        if (pref === 'off' || (reduce && pref !== 'on')) { r.classList.add('no-motion'); return; }
        // Beranda: sembunyikan menu bar dan hero sebelum paint pertama; animasi muncul (index.astro) membukanya.
        // Pengaman: bila skrip animasi gagal jalan, kelas dilepas setelah 5 detik (atau setelah batas loader)
        // supaya konten tetap terlihat.
        if (location.pathname === '/') {
          r.classList.add('hero-intro');
          setTimeout(function () { r.classList.remove('hero-intro'); }, loading ? 95000 : 5000);
        }
        try {
          if (sessionStorage.getItem('bb-pt')) r.classList.add('pt-cover');
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-mood="night" class:list={{ 'wide-sections': Astro.url.pathname !== '/' }}>
    <a class="sr-only" href="#main">Skip to content</a>
    {loader && (
      <div class="loader" role="status" aria-live="polite" aria-label="Loading website">
        <div class="loader-top">
          <b class="loader-mark">magia<span>pix</span></b>
          <p class="loader-note">The website is currently under development. Slow connection speeds may make the website load longer. Please ensure your connection is fast. Please wait.</p>
        </div>
        <p class="loader-num" aria-hidden="true"><span class="ctr">0</span>%</p>
        <div class="loader-bar" aria-hidden="true"><i></i></div>
        <!-- Tepi bawah melengkung yang ikut panel saat terangkat keluar (loader.ts) -->
        <div class="loader-curve" aria-hidden="true"></div>
      </div>
    )}
    <div class="pt" aria-hidden="true"><span></span></div>
    <!-- Panel transisi: isi nama halaman tujuan sejak paint pertama. Tanpa ini panel tampil kosong ~0,3 detik
         sampai skrip utama dimuat, lalu teksnya muncul lagi (terlihat berkedip). -->
    <script is:inline>
      try { var n = sessionStorage.getItem('bb-pt'); if (n) document.querySelector('.pt span').textContent = n; } catch (e) {}
    </script>
    <Header />
    <Menu />
    <main id="main"><slot /></main>
    <Footer />
    <a class="email-contact" href={SITE.emailHref} aria-label={`Email ${SITE.email}`} data-magnetic>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </svg>
      <span class="lbl">Contact us</span>
    </a>
    <div class="cursor" aria-hidden="true"><span>View</span></div>
    <script>import '../scripts/main';</script>
  </body>
</html>

<style>
  :global(body.wide-sections .site-header) { position: absolute; }
  :global(body .site-header.is-solid) { box-shadow: none; }
  :global(body.wide-sections main .wrap) { max-width: none; }
  :global(body.wide-sections .site-header .wrap) { max-width: none; }
</style>
